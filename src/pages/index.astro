---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CompareTable from '../components/CompareTable.astro';
import AsOf from '../components/AsOf.astro';

// Capabilities — from the README feature set.
const features = [
  { title: 'Data Explorer', body: 'Browse catalogs, namespaces, and tables with schema inspection and Databricks-style column profiling.' },
  { title: 'Query Editor', body: 'Execute SQL via SQE (Arrow Flight SQL), Trino, or Spark Connect with inline results, history, and row counts.' },
  { title: 'dbt Workspace', body: 'Browser-based IDE: file editor, git operations, build/test/run, and dbt model lineage visualization.' },
  { title: 'AI Flows', body: 'Context-aware assistant powered by a local LLM with MCP tool integration. Schema-aware natural-language SQL.' },
  { title: 'Data Contracts', body: 'Visual ODCS v3.1.0 editor with quality checks, import from catalog, and dbt export.' },
  { title: 'Fine-grained RBAC', body: 'Table-level access control via OPA Rego policies, identity from Keycloak. service_admin → table_reader.' },
  { title: 'Observability', body: 'OpenTelemetry traces, OCSF audit logging, Jaeger UI — see every query and access decision.' },
  { title: 'Column-level lineage', body: 'dbt model lineage with auto-layout, column-level tracking, and search across the warehouse.' },
];

// Open-standards stack — SQE-first.
const stackHead = ['Capability', 'Technology', 'Lock-in risk'];
const stackRows = [
  { label: 'Data format', cells: [{ t: 'Apache Iceberg' }, { t: 'none — open table format', tone: 'yes' }] },
  { label: 'Data catalog', cells: [{ t: 'Apache Polaris' }, { t: 'none — open REST catalog', tone: 'yes' }] },
  { label: 'Query engine', cells: [{ t: 'SQE (Flight SQL) · Trino · Spark Connect', tone: 'emph' }, { t: 'none — ANSI SQL, JDBC/ODBC', tone: 'yes' }] },
  { label: 'Identity', cells: [{ t: 'Keycloak / OpenID Connect' }, { t: 'none — any OIDC provider', tone: 'yes' }] },
  { label: 'Authorization', cells: [{ t: 'OPA + Rego policies' }, { t: 'none — open policy standard', tone: 'yes' }] },
  { label: 'Storage', cells: [{ t: 'Any S3-compatible backend' }, { t: 'none — standard S3 API', tone: 'yes' }] },
];

// Comparison — from the doc's Summary table.
const cmpHead = ['', 'This platform', 'Typical cloud DW'];
const cmpRows = [
  { label: 'Vendor lock-in', cells: [{ t: 'zero — open source', tone: 'yes' }, { t: 'deep — proprietary', tone: 'no' }] },
  { label: 'Data format', cells: [{ t: 'Apache Iceberg', tone: 'emph' }, { t: 'proprietary internal' }] },
  { label: 'Data location', cells: [{ t: 'any cloud / on-prem', tone: 'yes' }, { t: 'vendor cloud only', tone: 'no' }] },
  { label: 'Identity provider', cells: [{ t: 'any OIDC', tone: 'yes' }, { t: 'vendor IAM only' }] },
  { label: 'Authorization', cells: [{ t: 'OPA — policy-as-code', tone: 'emph' }, { t: 'built-in, non-portable' }] },
  { label: 'Query engine', cells: [{ t: 'SQE / Trino — standard SQL', tone: 'yes' }, { t: 'proprietary drivers' }] },
  { label: 'AI analytics', cells: [{ t: 'local or cloud LLM — your choice', tone: 'yes' }, { t: "vendor's AI service" }] },
  { label: 'Exit strategy', cells: [{ t: 'walk away — data is Iceberg/Parquet', tone: 'yes' }, { t: 'multi-year migration', tone: 'no' }] },
  { label: 'Cost model', cells: [{ t: 'infrastructure only', tone: 'yes' }, { t: 'per-query + markup', tone: 'no' }] },
];

// Pricing — "More info" detail bullets per managed model.
const saasMore = [
  'Operated end-to-end by Schuberg Philis: provisioning, upgrades, patching, backups, monitoring.',
  '24×7 mission-critical operations with an agreed SLA.',
  'Runs in an EU/sovereign region of your choice; your data stays in-region.',
  'Per-query identity (Keycloak OIDC) + OPA policies — your IdP, your rules.',
  'Exit anytime: data stays in open Apache Iceberg/Parquet, catalog in Polaris.',
];
const ownMore = [
  'Deployed on your Kubernetes — private cloud or on-prem — via Helm + GitOps.',
  'Your data never leaves your premises; SBP operates the platform, not the data.',
  'Air-gapped / regulated-environment friendly; bring your own storage + IdP.',
  'Same open stack as SaaS — no proprietary format, no per-query fees.',
];

// Roadmap.
const roadmap = [
  { feature: 'Catalog federation', desc: 'Connect Snowflake, Databricks, AWS Glue catalogs — query across platforms with one SQL interface.' },
  { feature: 'Column / row-level security', desc: 'Fine-grained OPA policies for column masking and row filtering.' },
  { feature: 'Streaming ingestion', desc: 'Apache Flink for real-time data pipelines.' },
  { feature: 'CSV import / export', desc: 'Upload CSV to Iceberg tables; download query results as CSV/Parquet.' },
  { feature: 'Okta integration', desc: 'Direct Okta OIDC support alongside Keycloak.' },
  { feature: 'Full GitOps deployment', desc: 'Argo CD application sets with environment promotion.' },
];
---

<BaseLayout title="Cloud Independent Data Platform — Own your data. Run anywhere." darkHeader>
  <Hero />

  <!-- PROBLEM -->
  <section class="section" id="problem">
    <div class="container">
      <SectionHeading eyebrow="The problem" title="Your data infrastructure serves the vendor — not the business." center />
      <div class="why-grid">
        <div class="card why-card">
          <h3>Vendor lock-in</h3>
          <p>Cloud-native warehouses create deep dependency on a single provider. Migrating away costs millions and takes years.</p>
        </div>
        <div class="card why-card">
          <h3>Data sovereignty</h3>
          <p>GDPR, DORA, and NIS2 demand control over where data lives and who can access it. Proprietary platforms make compliance a moving target.</p>
        </div>
        <div class="card why-card">
          <h3>Fragmented tooling</h3>
          <p>Catalogs, query engines, access control, and storage — each with its own API, auth model, and upgrade cycle. Rising cost, audit nightmares.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section section--tight what" id="solution">
    <div class="container">
      <SectionHeading eyebrow="The solution" title="One platform. Zero proprietary dependencies." />
      <p class="lead">A fully integrated data platform built exclusively on open standards — every layer governed by a vendor-neutral body, swappable at will.</p>
      <CompareTable head={stackHead} rows={stackRows} />
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section" id="capabilities">
    <div class="container">
      <SectionHeading eyebrow="What it does" title="Catalog, query, dbt, AI, and governance — in one place." />
      <FeatureGrid items={features} columns={4} />
      <div class="shots">
        <figure class="shotcard">
          <img src="/screenshots/admin-overview.png" width="2880" height="1800" loading="lazy" decoding="async" data-zoom
               alt="Admin overview — catalogs, namespaces, tables, principals, and roles" />
          <figcaption>Admin overview — catalogs, principals, and roles at a glance.</figcaption>
        </figure>
        <figure class="shotcard">
          <img src="/screenshots/data-contracts.png" width="2880" height="1800" loading="lazy" decoding="async" data-zoom
               alt="Data Contracts — ODCS contracts across catalogs with quality status" />
          <figcaption>Data contracts — ODCS, versioned, with quality status per table.</figcaption>
        </figure>
        <figure class="shotcard">
          <img src="/screenshots/dbt-projects.png" width="2880" height="1800" loading="lazy" decoding="async" data-zoom
               alt="dbt projects — connect a git repo and build" />
          <figcaption>dbt workspace — bring a git repo, build and test in the browser.</figcaption>
        </figure>
        <figure class="shotcard">
          <img src="/screenshots/workspaces.png" width="2880" height="1800" loading="lazy" decoding="async" data-zoom
               alt="Workspace picker — per-team workspaces on one platform" />
          <figcaption>Per-team workspaces, one governed platform.</figcaption>
        </figure>
      </div>
      <p class="ph-note">Flagship views — query editor, catalog explorer, and lineage — join the gallery in a later beta drop.</p>
    </div>
  </section>

  <!-- ENGINE -->
  <section class="section what" id="engine">
    <div class="container">
      <SectionHeading eyebrow="The query engine" title="SQE first — Trino-compatible." />
      <div class="how-grid">
        <div>
          <h3 class="section-marker">SQE — sovereign, fast, no JVM</h3>
          <p>The <code>sqe</code> deployment mode runs the <a href="https://getsqe.com">Sovereign Query Engine</a> in place of Trino: Arrow Flight SQL on the wire, per-query identity, and <a href="https://getsqe.com/compare/iceberg/">highly Iceberg-compatible</a> reads and writes — V2 <em>and</em> V3. Every query runs as the authenticated user; the bearer token flows through to the catalog and storage.</p>
        </div>
        <div>
          <h3 class="section-marker">Trino-compatible, Spark for engineering</h3>
          <p>SQE speaks the Trino HTTP protocol too, so existing clients connect unchanged — or swap in Trino itself. For heavy data engineering, <strong>Spark Connect</strong> runs against the same Iceberg tables, no copies. Either way it's ANSI SQL over standard JDBC/ODBC — no proprietary drivers.</p>
        </div>
      </div>
      <h3 class="proof-sub section-marker">Connect anything that speaks SQL</h3>
      <p class="lead">Tableau · Power BI · DBeaver · DataGrip · dbt · Python/pandas · Spark Connect · the built-in Query Editor — all via Flight SQL or standard JDBC/ODBC. No data copying; queries run against data in place.</p>
    </div>
  </section>

  <!-- SECURITY -->
  <section class="section" id="security">
    <div class="container">
      <SectionHeading eyebrow="Enterprise security" title="Two layers, both open: Keycloak + OPA." />
      <div class="how-grid">
        <div>
          <h3 class="section-marker">Authentication — Keycloak (OIDC)</h3>
          <p>OpenID Connect standard — swap for Okta, Azure AD, or any OIDC provider. SSO, MFA, user federation. BFF-style auth: no tokens exposed to the browser. Group and role claims minted into every token.</p>
        </div>
        <div>
          <h3 class="section-marker">Authorization — OPA (Rego)</h3>
          <p>One policy engine for the whole platform. Catalog-level (catalogs, namespaces, tables), query-level (execution, visibility, row filtering). Policy-as-code: version, review, and audit every access rule. Roles from service_admin to table_reader.</p>
        </div>
      </div>
      <h3 class="proof-sub section-marker">Catalog grants — on top of Apache Polaris</h3>
      <p class="lead"><code>GRANT</code> and <code>REVOKE</code> privileges on catalogs, namespaces, and tables using Polaris's native RBAC security model — then layer OPA policies on top for row- and column-level rules. Standard, portable grants; no vendor-specific access model to migrate away from.</p>
    </div>
  </section>

  <!-- DEPLOY — dark interlude -->
  <section class="section section--dark" id="deploy">
    <div class="container">
      <SectionHeading eyebrow="Deploy anywhere" title="Kubernetes-native. Your cloud, sovereign cloud, or on-prem." />
      <div class="how-grid">
        <div>
          <h3 class="section-marker">Runs where your data must live</h3>
          <ul class="modes">
            <li><strong>Hyperscalers</strong> — AWS, Azure, GCP.</li>
            <li><strong>Sovereign clouds</strong> — STACKIT and other EU sovereign providers.</li>
            <li><strong>Private cloud / on-prem</strong> — your datacenter, your hardware.</li>
          </ul>
          <p class="how-foot">The same open stack everywhere — no managed-service lock-in, no per-query fees.</p>
        </div>
        <div>
          <h3 class="section-marker">Kubernetes + Helm, GitOps-ready</h3>
          <p>Production deploys via Helm charts on any conformant Kubernetes: Polaris, the query engine (SQE or Trino), Spark Connect, Keycloak, OPA, and the portals — with horizontal scaling and Argo CD GitOps delivery. Storage is any S3-compatible backend.</p>
        </div>
      </div>
      <p class="ph-note">Beta: public Helm charts and a hosted demo are on the way.</p>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section proof" id="compare">
    <div class="container">
      <SectionHeading eyebrow="The receipts" title="Cloud Independent Data Platform vs typical cloud DW." />
      <CompareTable head={cmpHead} rows={cmpRows} />
      <div class="proof-cta">
        <a class="btn btn--primary" href="#pricing">See pricing</a>
        <a class="btn btn--ghost-dark" href="#roadmap">Roadmap →</a>
        <a class="btn btn--ghost-dark" href="#about">Why we built it</a>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" id="pricing">
    <div class="container">
      <SectionHeading eyebrow="Pricing" title="Run it as a managed service." center />
      <p class="lede">
        The platform is delivered as a <strong>managed service</strong> — you choose where it runs,
        Schuberg Philis runs it. Pricing is usage-based on <strong>data volume and workloads</strong>;
        tell us your shape below and we'll send a quote.
      </p>

      <div class="managed">
        <img class="managed__logo" src="/brand/sbp-logo-black.svg" width="170" height="46" alt="Schuberg Philis" />
        <span class="managed__txt">Managed Service by <strong>Schuberg Philis</strong> — mission-critical operations, 24×7.</span>
      </div>

      <div class="plans">
        <article class="plan plan--featured">
          <span class="plan__tag">SaaS · fully managed</span>
          <h3 class="plan__title">Sovereign SaaS</h3>
          <p class="plan__where">Runs on <strong>Schuberg Philis Cloud</strong>, <strong>STACKIT</strong> (sovereign EU), or <strong>AWS Sovereign Cloud</strong>.</p>
          <ul class="plan__list">
            <li>Fully hosted &amp; operated by Schuberg Philis</li>
            <li>EU / sovereign regions — data stays in-region</li>
            <li>Iceberg · Polaris · SQE/Trino · Spark · OPA · Keycloak</li>
            <li>Usage-based — by data volume &amp; workloads</li>
          </ul>
          <details class="plan__more">
            <summary>More info</summary>
            <ul>{saasMore.map((b) => <li>{b}</li>)}</ul>
          </details>
          <a class="btn btn--primary plan__cta" href="#quote">Request a quote →</a>
        </article>

        <article class="plan">
          <span class="plan__tag">Managed · your infrastructure</span>
          <h3 class="plan__title">Managed in your data center</h3>
          <p class="plan__where">Your <strong>private cloud</strong> or <strong>on-premises</strong> — operated by Schuberg Philis.</p>
          <ul class="plan__list">
            <li>Deployed on your Kubernetes (Helm + GitOps)</li>
            <li>Data never leaves your premises</li>
            <li>Air-gapped / regulated-environment friendly</li>
            <li>Operated end-to-end by Schuberg Philis</li>
          </ul>
          <details class="plan__more">
            <summary>More info</summary>
            <ul>{ownMore.map((b) => <li>{b}</li>)}</ul>
          </details>
          <a class="btn btn--primary plan__cta" href="#quote">Request a quote →</a>
        </article>
      </div>
      <p class="ph-note">Both models are the same open platform — zero proprietary lock-in, walk away with your Iceberg data anytime.</p>
    </div>
  </section>

  <!-- QUOTE FORM -->
  <section class="section what" id="quote">
    <div class="container narrow">
      <SectionHeading eyebrow="Request a quote" title="Tell us your shape." />
      <p class="lede lede--left">Pick the options below and we'll prepare a quote. Submitting opens your mail client addressed to <a href="mailto:info@sovereign-data.org">info@sovereign-data.org</a>.</p>

      <form id="quote-form" class="quote">
        <fieldset class="quote__set">
          <legend>Where should it run?</legend>
          <label class="opt"><input type="radio" name="hosting" value="Schuberg Philis Cloud (SaaS)" checked /> Schuberg Philis Cloud <em>SaaS</em></label>
          <label class="opt"><input type="radio" name="hosting" value="STACKIT — sovereign EU (SaaS)" /> STACKIT — sovereign EU <em>SaaS</em></label>
          <label class="opt"><input type="radio" name="hosting" value="AWS Sovereign Cloud (SaaS)" /> AWS Sovereign Cloud <em>SaaS</em></label>
          <label class="opt"><input type="radio" name="hosting" value="Our own data center / private cloud (Managed)" /> Our own data center / private cloud <em>Managed</em></label>
        </fieldset>

        <fieldset class="quote__set">
          <legend>How much data?</legend>
          <label class="opt"><input type="radio" name="data" value="10–100 TB" checked /> 10–100 TB</label>
          <label class="opt"><input type="radio" name="data" value="100 TB – 1 PB" /> 100 TB – 1 PB</label>
          <label class="opt"><input type="radio" name="data" value="> 1 PB" /> &gt; 1 PB</label>
        </fieldset>

        <fieldset class="quote__set">
          <legend>Primary workloads</legend>
          <label class="opt"><input type="radio" name="workloads" value="Analytics & BI" checked /> Analytics &amp; BI</label>
          <label class="opt"><input type="radio" name="workloads" value="dbt transformations" /> dbt transformations</label>
          <label class="opt"><input type="radio" name="workloads" value="AI & ML" /> AI &amp; ML</label>
          <label class="opt"><input type="radio" name="workloads" value="Streaming" /> Streaming</label>
          <label class="opt"><input type="radio" name="workloads" value="Mixed" /> Mixed</label>
        </fieldset>

        <label class="quote__field">Work email <span>(required)</span>
          <input type="email" name="email" placeholder="you@company.com" required />
        </label>
        <label class="quote__field">Anything else? <span>(optional)</span>
          <textarea name="notes" rows="3" placeholder="Context, timeline, compliance needs…"></textarea>
        </label>

        <button type="submit" class="btn btn--primary">Request a quote →</button>
        <p class="quote__alt">…or email <a href="mailto:info@sovereign-data.org">info@sovereign-data.org</a> directly.</p>
      </form>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="section" id="roadmap">
    <div class="container">
      <SectionHeading eyebrow="Roadmap" title="What's planned." />
      <AsOf />
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Feature</th><th>Description</th></tr></thead>
          <tbody>
            {roadmap.map((r) => (
              <tr><td><strong>{r.feature}</strong></td><td>{r.desc}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="how-foot">All items are planned, not committed dates — this is a beta. Shipped capabilities are <a href="#capabilities">above</a>.</p>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section what" id="about">
    <div class="container narrow">
      <SectionHeading eyebrow="About" title="Sovereignty is an architecture, not a checkbox." />
      <p>The Cloud Independent Data Platform exists because most "data sovereignty" is a setting in someone else's console. Real sovereignty means you can pick up your data and your access policies and walk to a different cloud — or to your own datacenter — without a multi-year migration.</p>
      <p>So every layer is a widely adopted open standard governed by a neutral body: Apache Iceberg and Polaris for tables and catalog, ANSI SQL via SQE or Trino for query, OpenID Connect for identity, OPA/Rego for authorization, the S3 API for storage, Kubernetes + Helm for deployment. No single vendor controls any component of the stack.</p>
      <p>That makes regulations like GDPR, DORA, and NIS2 tractable: data location is your choice, access decisions are policy-as-code you can audit, and there is no proprietary format holding you hostage.</p>
      <h3 class="section-marker about__h">Built by Schuberg Philis</h3>
      <p>The platform is designed and built by <a href="https://schubergphilis.com" target="_blank" rel="noopener noreferrer">Schuberg Philis</a>, integrating proven open-source components — Polaris, Keycloak, OPA, Trino, the Sovereign Query Engine — into one secure, operable whole. It pairs with <a href="https://getsqe.com">SQE</a>, the sovereign query engine that powers the platform's <code>sqe</code> deployment mode.</p>
      <p class="ph-note">Beta: this site tells the story; product screenshots, a hosted demo, and public images are on the way.</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Quote form → compose a prefilled mailto (static site, no backend).
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = (n: string) =>
      (form.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement | null)?.value || '—';
    const email = (form.querySelector('[name="email"]') as HTMLInputElement)?.value.trim();
    const notes = (form.querySelector('[name="notes"]') as HTMLTextAreaElement)?.value.trim();
    const lines = [
      'Cloud Independent Data Platform — managed hosting inquiry',
      '',
      `Hosting:   ${val('hosting')}`,
      `Data:      ${val('data')}`,
      `Workloads: ${val('workloads')}`,
      email ? `Reply to:  ${email}` : '',
      '',
      notes ? `Notes:\n${notes}` : '',
    ].filter((l) => l !== '');
    const subject = 'Managed platform quote request';
    const href = `mailto:info@sovereign-data.org?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    window.location.href = href;
  });
</script>

<style>
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .why-card { display: flex; flex-direction: column; }
  .why-card h3 { font-size: 1.1rem; }
  .why-card p { font-size: 0.94rem; color: var(--text-muted); flex: 1; }
  .what { background: #fff; border-block: 1px solid var(--border); }
  .lead { font-size: 1.05rem; color: var(--text-muted); max-width: 70ch; margin-bottom: 24px; }
  .how-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .how-grid h3 { font-size: 1.1rem; margin-bottom: 14px; }
  .modes { margin: 0 0 14px; padding-left: 18px; color: var(--text-muted); font-size: 0.95rem; }
  .modes li { margin-bottom: 8px; }
  .modes strong { color: var(--text); }
  .how-foot { color: var(--text-muted); font-size: 0.92rem; }
  .how-foot { margin-top: 20px; }
  .ph-note { margin-top: 22px; font-size: 0.88rem; color: var(--text-muted); font-style: italic; }
  .shots { margin-top: 32px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .shotcard { margin: 0; }
  .shotcard img { display: block; width: 100%; height: auto; border: 1px solid var(--border);
    border-radius: var(--radius-sm); box-shadow: 0 10px 30px rgba(2, 12, 23, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .shotcard img:hover { transform: translateY(-4px) scale(1.012); border-color: rgba(30, 128, 237, 0.5);
    box-shadow: 0 18px 44px rgba(8, 38, 70, 0.18); }
  .shotcard figcaption { margin-top: 10px; font-size: 0.88rem; color: var(--text-muted); }
  .proof { background: #fff; border-top: 1px solid var(--border); }
  .proof-sub { margin-top: 44px; font-size: 1.2rem; }
  .proof-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }

  /* Pricing */
  .lede { font-size: 1.08rem; color: var(--text-muted); max-width: 70ch; margin: 0 auto 28px; text-align: center; }
  .lede--left { text-align: left; margin-left: 0; }
  .narrow { max-width: 760px; }
  .managed { display: flex; align-items: center; gap: 16px; justify-content: center; flex-wrap: wrap;
    background: var(--soft-blue); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 16px 22px; margin: 0 auto 36px; max-width: 760px; }
  .managed__logo { height: 38px; width: auto; display: block; }
  .managed__txt { font-size: 0.96rem; color: var(--text); }
  .plans { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .plan { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 26px 24px; display: flex; flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .plan:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(8, 38, 70, 0.10); }
  /* Featured: SBP Blue edge + lift — visual emphasis only. */
  .plan--featured { border: 2px solid var(--sqe-blue); box-shadow: 0 12px 36px rgba(30, 128, 237, 0.14); }
  /* Dark interlude readability for notes inside #deploy. */
  .section--dark .ph-note { color: rgba(255, 255, 255, 0.6); }
  .section--dark .how-foot { color: rgba(255, 255, 255, 0.72); }
  .section--dark .modes { color: rgba(255, 255, 255, 0.78); }
  .section--dark .modes strong { color: #fff; }
