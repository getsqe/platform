---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CompareTable from '../components/CompareTable.astro';

// Capabilities — from the README feature set.
const features = [
  { title: 'Data Explorer', body: 'Browse catalogs, namespaces, and tables with schema inspection and Databricks-style column profiling.' },
  { title: 'Query Editor', body: 'Execute SQL via SQE (Arrow Flight SQL), Trino, or Spark Connect with inline results, history, and row counts.' },
  { title: 'dbt Workspace', body: 'Browser-based IDE: file editor, git operations, build/test/run, and dbt model lineage visualization.' },
  { title: 'AI Flows', body: 'Context-aware assistant powered by a local LLM with MCP tool integration. Schema-aware natural-language SQL.' },
  { title: 'Data Contracts', body: 'Visual ODCS v3.1.0 editor with quality checks, import from catalog, and dbt export.' },
  { title: 'Fine-grained RBAC', body: 'Table-level access control via OPA Rego policies, identity from Keycloak. service_admin → table_reader.' },
  { title: 'Observability', body: 'OpenTelemetry traces, OCSF audit logging, Jaeger UI — see every query and access decision.' },
  { title: 'Column-level lineage', body: 'dbt model lineage with auto-layout, column-level tracking, and search across the warehouse.' },
];

// Open-standards stack — SQE-first.
const stackHead = ['Capability', 'Technology', 'Lock-in risk'];
const stackRows = [
  { label: 'Data format', cells: [{ t: 'Apache Iceberg' }, { t: 'none — open table format', tone: 'yes' }] },
  { label: 'Data catalog', cells: [{ t: 'Apache Polaris' }, { t: 'none — open REST catalog', tone: 'yes' }] },
  { label: 'Query engine', cells: [{ t: 'SQE (Flight SQL), Trino-compatible', tone: 'emph' }, { t: 'none — ANSI SQL, JDBC/ODBC', tone: 'yes' }] },
  { label: 'Identity', cells: [{ t: 'Keycloak / OpenID Connect' }, { t: 'none — any OIDC provider', tone: 'yes' }] },
  { label: 'Authorization', cells: [{ t: 'OPA + Rego policies' }, { t: 'none — open policy standard', tone: 'yes' }] },
  { label: 'Storage', cells: [{ t: 'Any S3-compatible backend' }, { t: 'none — standard S3 API', tone: 'yes' }] },
];

// Comparison — from the doc's Summary table.
const cmpHead = ['', 'This platform', 'Typical cloud DW'];
const cmpRows = [
  { label: 'Vendor lock-in', cells: [{ t: 'zero — open source', tone: 'yes' }, { t: 'deep — proprietary', tone: 'no' }] },
  { label: 'Data format', cells: [{ t: 'Apache Iceberg', tone: 'emph' }, { t: 'proprietary internal' }] },
  { label: 'Data location', cells: [{ t: 'any cloud / on-prem', tone: 'yes' }, { t: 'vendor cloud only', tone: 'no' }] },
  { label: 'Identity provider', cells: [{ t: 'any OIDC', tone: 'yes' }, { t: 'vendor IAM only' }] },
  { label: 'Authorization', cells: [{ t: 'OPA — policy-as-code', tone: 'emph' }, { t: 'built-in, non-portable' }] },
  { label: 'Query engine', cells: [{ t: 'SQE / Trino — standard SQL', tone: 'yes' }, { t: 'proprietary drivers' }] },
  { label: 'AI analytics', cells: [{ t: 'local or cloud LLM — your choice', tone: 'yes' }, { t: "vendor's AI service" }] },
  { label: 'Exit strategy', cells: [{ t: 'walk away — data is Iceberg/Parquet', tone: 'yes' }, { t: 'multi-year migration', tone: 'no' }] },
  { label: 'Cost model', cells: [{ t: 'infrastructure only', tone: 'yes' }, { t: 'per-query + markup', tone: 'no' }] },
];
---

<BaseLayout title="Cloud Independent Data Platform — Own your data. Run anywhere." darkHeader>
  <Hero />

  <!-- PROBLEM -->
  <section class="section" id="problem">
    <div class="container">
      <SectionHeading eyebrow="The problem" title="Your data infrastructure serves the vendor — not the business." center />
      <div class="why-grid">
        <div class="card why-card">
          <h3>Vendor lock-in</h3>
          <p>Cloud-native warehouses create deep dependency on a single provider. Migrating away costs millions and takes years.</p>
        </div>
        <div class="card why-card">
          <h3>Data sovereignty</h3>
          <p>GDPR, DORA, and NIS2 demand control over where data lives and who can access it. Proprietary platforms make compliance a moving target.</p>
        </div>
        <div class="card why-card">
          <h3>Fragmented tooling</h3>
          <p>Catalogs, query engines, access control, and storage — each with its own API, auth model, and upgrade cycle. Rising cost, audit nightmares.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section section--tight what" id="solution">
    <div class="container">
      <SectionHeading eyebrow="The solution" title="One platform. Zero proprietary dependencies." />
      <p class="lead">A fully integrated data platform built exclusively on open standards — every layer governed by a vendor-neutral body, swappable at will.</p>
      <CompareTable head={stackHead} rows={stackRows} />
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section" id="capabilities">
    <div class="container">
      <SectionHeading eyebrow="What it does" title="Catalog, query, dbt, AI, and governance — in one place." />
      <FeatureGrid items={features} columns={4} />
      <div class="shots">
        <figure class="shotcard">
          <img src="/screenshots/admin-overview.png" width="2880" height="1800" loading="lazy" decoding="async"
               alt="Admin overview — catalogs, namespaces, tables, principals, and roles" />
          <figcaption>Admin overview — catalogs, principals, and roles at a glance.</figcaption>
        </figure>
        <figure class="shotcard">
          <img src="/screenshots/data-contracts.png" width="2880" height="1800" loading="lazy" decoding="async"
               alt="Data Contracts — ODCS contracts across catalogs with quality status" />
          <figcaption>Data contracts — ODCS, versioned, with quality status per table.</figcaption>
        </figure>
        <figure class="shotcard">
          <img src="/screenshots/dbt-projects.png" width="2880" height="1800" loading="lazy" decoding="async"
               alt="dbt projects — connect a git repo and build" />
          <figcaption>dbt workspace — bring a git repo, build and test in the browser.</figcaption>
        </figure>
        <figure class="shotcard">
          <img src="/screenshots/workspaces.png" width="2880" height="1800" loading="lazy" decoding="async"
               alt="Workspace picker — per-team workspaces on one platform" />
          <figcaption>Per-team workspaces, one governed platform.</figcaption>
        </figure>
      </div>
      <p class="ph-note">Flagship views — query editor, catalog explorer, and lineage — join the gallery in a later beta drop.</p>
    </div>
  </section>

  <!-- ENGINE -->
  <section class="section what" id="engine">
    <div class="container">
      <SectionHeading eyebrow="The query engine" title="SQE first — Trino-compatible." />
      <div class="how-grid">
        <div>
          <h3 class="section-marker">SQE — sovereign, fast, no JVM</h3>
          <p>The <code>sqe</code> deployment mode runs the <a href="https://getsqe.com">Sovereign Query Engine</a> in place of Trino: Arrow Flight SQL on the wire, per-query identity, and <a href="https://getsqe.com/compare/iceberg/">highly Iceberg-compatible</a> reads and writes — V2 <em>and</em> V3. Every query runs as the authenticated user; the bearer token flows through to the catalog and storage.</p>
        </div>
        <div>
          <h3 class="section-marker">Trino-compatible, Spark for engineering</h3>
          <p>SQE speaks the Trino HTTP protocol too, so existing clients connect unchanged — or swap in Trino itself. For heavy data engineering, <strong>Spark Connect</strong> runs against the same Iceberg tables, no copies. Either way it's ANSI SQL over standard JDBC/ODBC — no proprietary drivers.</p>
        </div>
      </div>
      <h3 class="proof-sub section-marker">Connect anything that speaks SQL</h3>
      <p class="lead">Tableau · Power BI · DBeaver · DataGrip · dbt · Python/pandas · Spark Connect · the built-in Query Editor — all via Flight SQL or standard JDBC/ODBC. No data copying; queries run against data in place.</p>
    </div>
  </section>

  <!-- SECURITY -->
  <section class="section" id="security">
    <div class="container">
      <SectionHeading eyebrow="Enterprise security" title="Two layers, both open: Keycloak + OPA." />
      <div class="how-grid">
        <div>
          <h3 class="section-marker">Authentication — Keycloak (OIDC)</h3>
          <p>OpenID Connect standard — swap for Okta, Azure AD, or any OIDC provider. SSO, MFA, user federation. BFF-style auth: no tokens exposed to the browser. Group and role claims minted into every token.</p>
        </div>
        <div>
          <h3 class="section-marker">Authorization — OPA (Rego)</h3>
          <p>One policy engine for the whole platform. Catalog-level (catalogs, namespaces, tables), query-level (execution, visibility, row filtering). Policy-as-code: version, review, and audit every access rule. Roles from service_admin to table_reader.</p>
        </div>
      </div>
      <h3 class="proof-sub section-marker">Catalog grants — on top of Apache Polaris</h3>
      <p class="lead"><code>GRANT</code> and <code>REVOKE</code> privileges on catalogs, namespaces, and tables using Polaris's native RBAC security model — then layer OPA policies on top for row- and column-level rules. Standard, portable grants; no vendor-specific access model to migrate away from.</p>
    </div>
  </section>

  <!-- DEPLOY -->
  <section class="section how" id="deploy">
    <div class="container">
      <SectionHeading eyebrow="Deploy anywhere" title="Kubernetes-native. Your cloud, sovereign cloud, or on-prem." />
      <div class="how-grid">
        <div>
          <h3 class="section-marker">Runs where your data must live</h3>
          <ul class="modes">
            <li><strong>Hyperscalers</strong> — AWS, Azure, GCP.</li>
            <li><strong>Sovereign clouds</strong> — STACKIT and other EU sovereign providers.</li>
            <li><strong>Private cloud / on-prem</strong> — your datacenter, your hardware.</li>
          </ul>
          <p class="how-foot">The same open stack everywhere — no managed-service lock-in, no per-query fees.</p>
        </div>
        <div>
          <h3 class="section-marker">Kubernetes + Helm, GitOps-ready</h3>
          <p>Production deploys via Helm charts on any conformant Kubernetes: Polaris, the query engine (SQE or Trino), Spark Connect, Keycloak, OPA, and the portals — with horizontal scaling and Argo CD GitOps delivery. Storage is any S3-compatible backend.</p>
        </div>
      </div>
      <p class="ph-note">Beta: public Helm charts and a hosted demo are on the way.</p>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section proof" id="compare">
    <div class="container">
      <SectionHeading eyebrow="The receipts" title="Cloud Independent Data Platform vs typical cloud DW." />
      <CompareTable head={cmpHead} rows={cmpRows} />
      <div class="proof-cta">
        <a class="btn btn--primary" href="#deploy">Deploy anywhere</a>
        <a class="btn btn--ghost-dark" href="/roadmap">See the roadmap →</a>
        <a class="btn btn--ghost-dark" href="/about">Why we built it</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .why-card { display: flex; flex-direction: column; }
  .why-card h3 { font-size: 1.1rem; }
  .why-card p { font-size: 0.94rem; color: var(--text-muted); flex: 1; }
  .what { background: #fff; border-block: 1px solid var(--border); }
  .lead { font-size: 1.05rem; color: var(--text-muted); max-width: 70ch; margin-bottom: 24px; }
  .how-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .how-grid h3 { font-size: 1.1rem; margin-bottom: 14px; }
  .code { background: var(--midnight); color: #cdd9e5; border-radius: var(--radius-sm); padding: 18px 20px; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.7; overflow-x: auto; border: 1px solid rgba(30, 232, 237, 0.16); }
  .code code { font-family: inherit; white-space: pre; }
  .modes { margin: 0 0 14px; padding-left: 18px; color: var(--text-muted); font-size: 0.95rem; }
  .modes li { margin-bottom: 8px; }
  .modes strong { color: var(--text); }
  .how-foot { color: var(--text-muted); font-size: 0.92rem; }
  .ph-note { margin-top: 22px; font-size: 0.88rem; color: var(--text-muted); font-style: italic; }
  .shots { margin-top: 32px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .shotcard { margin: 0; }
  .shotcard img { display: block; width: 100%; height: auto; border: 1px solid var(--border);
    border-radius: var(--radius-sm); box-shadow: 0 10px 30px rgba(2, 12, 23, 0.12); }
  .shotcard figcaption { margin-top: 10px; font-size: 0.88rem; color: var(--text-muted); }
  @media (max-width: 700px) { .shots { grid-template-columns: 1fr; } }
  .proof { background: #fff; border-top: 1px solid var(--border); }
  .proof-sub { margin-top: 44px; font-size: 1.2rem; }
  .proof-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  @media (max-width: 980px) { .why-grid { grid-template-columns: 1fr; } }
  @media (max-width: 820px) { .how-grid { grid-template-columns: 1fr; } }
</style>
