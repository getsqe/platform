---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AsOf from '../components/AsOf.astro';

const roadmap = [
  { feature: 'Catalog federation', desc: 'Connect Snowflake, Databricks, AWS Glue catalogs — query across platforms with one SQL interface.' },
  { feature: 'Column / row-level security', desc: 'Fine-grained OPA policies for column masking and row filtering.' },
  { feature: 'Streaming ingestion', desc: 'Apache Flink for real-time data pipelines.' },
  { feature: 'Cloud LLM providers', desc: 'OpenAI, Azure OpenAI, OpenRouter as alternatives to the local model for text-to-SQL.' },
  { feature: 'CSV import / export', desc: 'Upload CSV to Iceberg tables; download query results as CSV/Parquet.' },
  { feature: 'Audit log viewer', desc: 'Visual audit trail for access decisions and policy changes.' },
  { feature: 'Bucket browser', desc: 'S3 storage explorer in the admin portal.' },
  { feature: 'Okta integration', desc: 'Direct Okta OIDC support alongside Keycloak.' },
  { feature: 'Full GitOps deployment', desc: 'Argo CD application sets with environment promotion.' },
];
---
<BaseLayout title="Roadmap — Cloud Independent Data Platform">
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Roadmap" title="What's planned." />
      <AsOf />
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Feature</th><th>Description</th></tr></thead>
          <tbody>
            {roadmap.map((r) => (
              <tr><td><strong>{r.feature}</strong></td><td>{r.desc}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="foot">All items are planned, not committed dates — this is a beta. Shipped capabilities are on the <a href="/#capabilities">home page</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .foot { margin-top: 20px; color: var(--text-muted); font-size: 0.92rem; }
</style>
