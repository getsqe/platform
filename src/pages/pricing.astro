---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

// "More info" detail bullets per model — revealed via native <details>.
const saasMore = [
  'Operated end-to-end by Schuberg Philis: provisioning, upgrades, patching, backups, monitoring.',
  '24×7 mission-critical operations with an agreed SLA.',
  'Runs in an EU/sovereign region of your choice; your data stays in-region.',
  'Per-query identity (Keycloak OIDC) + OPA policies — your IdP, your rules.',
  'Exit anytime: data stays in open Apache Iceberg/Parquet, catalog in Polaris.',
];
const ownMore = [
  'Deployed on your Kubernetes — private cloud or on-prem — via Helm + GitOps.',
  'Your data never leaves your premises; SBP operates the platform, not the data.',
  'Air-gapped / regulated-environment friendly; bring your own storage + IdP.',
  'Same open stack as SaaS — no proprietary format, no per-query fees.',
  'Hand-over option: run it yourself later, no lock-in.',
];
---
<BaseLayout title="Pricing — Cloud Independent Data Platform">
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Pricing" title="Run it as a managed service." center />
      <p class="lede">
        The Cloud Independent Data Platform is delivered as a <strong>managed service</strong> —
        you choose where it runs, Schuberg Philis runs it. Pricing is usage-based on
        <strong>data volume and workloads</strong>; tell us your shape below and we'll send a quote.
      </p>

      <!-- Managed-by-SBP credit -->
      <div class="managed">
        <img class="managed__logo" src="/brand/sbp-logo-black.svg" width="170" height="46"
             alt="Schuberg Philis" />
        <span class="managed__txt">Managed Service by <strong>Schuberg Philis</strong> — mission-critical operations, 24×7.</span>
      </div>

      <!-- Offering columns -->
      <div class="plans">
        <article class="plan">
          <span class="plan__tag">SaaS · fully managed</span>
          <h3 class="plan__title">Sovereign SaaS</h3>
          <p class="plan__where">Runs on <strong>Schuberg Philis Cloud</strong>, <strong>STACKIT</strong> (sovereign EU), or <strong>AWS Sovereign Cloud</strong>.</p>
          <ul class="plan__list">
            <li>Fully hosted &amp; operated by Schuberg Philis</li>
            <li>EU / sovereign regions — data stays in-region</li>
            <li>Iceberg · Polaris · SQE/Trino · Spark · OPA · Keycloak</li>
            <li>Usage-based — by data volume &amp; workloads</li>
          </ul>
          <details class="plan__more">
            <summary>More info</summary>
            <ul>{saasMore.map((b) => <li>{b}</li>)}</ul>
          </details>
          <a class="btn btn--primary plan__cta" href="#quote">Request a quote →</a>
        </article>

        <article class="plan">
          <span class="plan__tag">Managed · your infrastructure</span>
          <h3 class="plan__title">Managed in your data center</h3>
          <p class="plan__where">Your <strong>private cloud</strong> or <strong>on-premises</strong> — operated by Schuberg Philis.</p>
          <ul class="plan__list">
            <li>Deployed on your Kubernetes (Helm + GitOps)</li>
            <li>Data never leaves your premises</li>
            <li>Air-gapped / regulated-environment friendly</li>
            <li>Operated by SBP, with a hand-over option</li>
          </ul>
          <details class="plan__more">
            <summary>More info</summary>
            <ul>{ownMore.map((b) => <li>{b}</li>)}</ul>
          </details>
          <a class="btn btn--primary plan__cta" href="#quote">Request a quote →</a>
        </article>
      </div>
      <p class="ph-note">Both models are the same open platform — zero proprietary lock-in, walk away with your Iceberg data anytime.</p>
    </div>
  </section>

  <!-- Quote form -->
  <section class="section what" id="quote">
    <div class="container narrow">
      <SectionHeading eyebrow="Request a quote" title="Tell us your shape." />
      <p class="lede">Pick the options below and we'll prepare a quote. Submitting opens your mail client addressed to <a href="mailto:info@sovereign-data.org">info@sovereign-data.org</a>.</p>

      <form id="quote-form" class="quote">
        <fieldset class="quote__set">
          <legend>Where should it run?</legend>
          <label class="opt"><input type="radio" name="hosting" value="Schuberg Philis Cloud (SaaS)" checked /> Schuberg Philis Cloud <em>SaaS</em></label>
          <label class="opt"><input type="radio" name="hosting" value="STACKIT — sovereign EU (SaaS)" /> STACKIT — sovereign EU <em>SaaS</em></label>
          <label class="opt"><input type="radio" name="hosting" value="AWS Sovereign Cloud (SaaS)" /> AWS Sovereign Cloud <em>SaaS</em></label>
          <label class="opt"><input type="radio" name="hosting" value="Our own data center / private cloud (Managed)" /> Our own data center / private cloud <em>Managed</em></label>
        </fieldset>

        <fieldset class="quote__set">
          <legend>How much data?</legend>
          <label class="opt"><input type="radio" name="data" value="< 1 TB" /> &lt; 1 TB</label>
          <label class="opt"><input type="radio" name="data" value="1–10 TB" checked /> 1–10 TB</label>
          <label class="opt"><input type="radio" name="data" value="10–100 TB" /> 10–100 TB</label>
          <label class="opt"><input type="radio" name="data" value="100 TB – 1 PB" /> 100 TB – 1 PB</label>
          <label class="opt"><input type="radio" name="data" value="> 1 PB" /> &gt; 1 PB</label>
        </fieldset>

        <fieldset class="quote__set">
          <legend>Primary workloads</legend>
          <label class="opt"><input type="radio" name="workloads" value="Analytics & BI" checked /> Analytics &amp; BI</label>
          <label class="opt"><input type="radio" name="workloads" value="dbt transformations" /> dbt transformations</label>
          <label class="opt"><input type="radio" name="workloads" value="AI & ML" /> AI &amp; ML</label>
          <label class="opt"><input type="radio" name="workloads" value="Streaming" /> Streaming</label>
          <label class="opt"><input type="radio" name="workloads" value="Mixed" /> Mixed</label>
        </fieldset>

        <label class="quote__field">Work email <span>(optional — so we can reply)</span>
          <input type="email" name="email" placeholder="you@company.com" />
        </label>
        <label class="quote__field">Anything else? <span>(optional)</span>
          <textarea name="notes" rows="3" placeholder="Context, timeline, compliance needs…"></textarea>
        </label>

        <button type="submit" class="btn btn--primary">Request a quote →</button>
        <p class="quote__alt">…or email <a href="mailto:info@sovereign-data.org">info@sovereign-data.org</a> directly.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = (n: string) =>
      (form.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement | null)?.value || '—';
    const email = (form.querySelector('[name="email"]') as HTMLInputElement)?.value.trim();
    const notes = (form.querySelector('[name="notes"]') as HTMLTextAreaElement)?.value.trim();
    const lines = [
      'Cloud Independent Data Platform — managed hosting inquiry',
      '',
      `Hosting:   ${val('hosting')}`,
      `Data:      ${val('data')}`,
      `Workloads: ${val('workloads')}`,
      email ? `Reply to:  ${email}` : '',
      '',
      notes ? `Notes:\n${notes}` : '',
    ].filter((l) => l !== '');
    const subject = 'Managed platform quote request';
    const href = `mailto:info@sovereign-data.org?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    window.location.href = href;
  });
</script>

<style>
  .lede { font-size: 1.08rem; color: var(--text-muted); max-width: 70ch; margin: 0 auto 28px; text-align: center; }
  #quote .lede { text-align: left; margin-left: 0; }
  .narrow { max-width: 760px; }

  .managed { display: flex; align-items: center; gap: 16px; justify-content: center; flex-wrap: wrap;
    background: var(--soft-blue); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 16px 22px; margin: 0 auto 36px; max-width: 760px; }
  .managed__logo { height: 38px; width: auto; display: block; }
  .managed__txt { font-size: 0.96rem; color: var(--text); }

  .plans { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .plan { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 26px 24px; display: flex; flex-direction: column; }
  .plan__tag { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent); }
  .plan__title { font-size: 1.4rem; margin: 8px 0 6px; }
  .plan__where { color: var(--text-muted); font-size: 0.95rem; }
  .plan__list { list-style: none; padding: 0; margin: 16px 0 0; }
  .plan__list li { position: relative; padding-left: 22px; margin-bottom: 9px; font-size: 0.95rem; }
  .plan__list li::before { content: "✓"; position: absolute; left: 0; color: var(--green); font-weight: 800; }
  .plan__more { margin: 14px 0 0; border-top: 1px solid var(--border); padding-top: 12px; }
  .plan__more summary { cursor: pointer; font-weight: 700; font-size: 0.9rem; color: var(--accent); }
  .plan__more[open] summary { margin-bottom: 10px; }
  .plan__more ul { margin: 0; padding-left: 18px; }
  .plan__more li { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 8px; }
  .plan__cta { margin-top: 20px; align-self: flex-start; }
  .ph-note { margin-top: 22px; font-size: 0.88rem; color: var(--text-muted); font-style: italic; text-align: center; }

  .what { background: #fff; border-top: 1px solid var(--border); }
  .quote { display: grid; gap: 22px; }
  .quote__set { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px 18px; margin: 0; }
  .quote__set legend { font-weight: 800; font-size: 0.95rem; padding: 0 6px; }
  .opt { display: inline-flex; align-items: center; gap: 8px; margin: 6px 18px 6px 0; font-size: 0.95rem; cursor: pointer; }
  .opt em { font-style: normal; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--accent); border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; }
  .quote__field { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: 0.92rem; }
  .quote__field span { font-weight: 400; color: var(--text-muted); }
  .quote__field input, .quote__field textarea { font: inherit; font-weight: 400; padding: 10px 12px;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: #fff; }
  .quote__alt { font-size: 0.88rem; color: var(--text-muted); margin: 0; }

  @media (max-width: 760px) { .plans { grid-template-columns: 1fr; } }
</style>
