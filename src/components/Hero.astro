---
// Dark hero with CTAs. Landing page only. Product screenshot lands in the
// right-hand panel later — placeholder for now.
---
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow">Cloud Independent Data Platform</span>
      <h1 class="hero__title">Own your data.<br />Run anywhere.</h1>
      <p class="hero__lede">
        A sovereign, open-source data platform built on Apache Iceberg, Polaris, SQE,
        and OPA. Enterprise-grade security, AI-assisted analytics, and total cloud
        independence — <strong>zero proprietary lock-in.</strong> Runs on Kubernetes:
        hyperscaler, sovereign cloud, private cloud, or on-prem.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#capabilities">See what it does</a>
        <a class="btn btn--ghost" href="#deploy">Deploy anywhere</a>
        <a class="btn btn--ghost" href="/about">Why sovereignty ↓</a>
      </div>
      <p class="hero__note">
        Open standards end to end: Apache Iceberg · Polaris · OPA · Keycloak · S3. No vendor IAM, no proprietary format.
      </p>
    </div>

    <div class="hero__demo">
      <div class="shot">
        <div class="shot__bar"><span></span><span></span><span></span></div>
        <img class="shot__img" src="/screenshots/workspace-home.png" width="2880" height="1800"
             loading="eager" decoding="async"
             alt="Cloud Independent Data Platform — workspace home: Discover, Build, Govern, Admin" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--space-gray); color: #fff; padding-block: clamp(48px, 7vw, 96px);
    background-image: radial-gradient(900px 400px at 78% -10%, rgba(30, 232, 237, 0.1), transparent 60%), radial-gradient(700px 380px at 10% 110%, rgba(30, 128, 237, 0.16), transparent 60%); }
  .hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; }
  .hero__eyebrow { font-family: var(--font-mono); color: var(--turquoise); font-size: 0.82rem; letter-spacing: 0.1em; font-weight: 600; }
  .hero__title { margin: 14px 0 20px; font-size: clamp(2.6rem, 5.2vw, 4rem); font-weight: 900; letter-spacing: -0.03em; color: #fff; }
  .hero__lede { font-size: 1.12rem; color: rgba(255, 255, 255, 0.8); max-width: 46ch; }
  .hero__lede strong { color: #fff; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .hero__note { margin-top: 22px; font-size: 0.86rem; color: rgba(255, 255, 255, 0.55); }

  /* Windowed product screenshot. */
  .shot { border: 1px solid rgba(30, 232, 237, 0.22); border-radius: var(--radius); overflow: hidden;
    background: rgba(2, 12, 23, 0.9); box-shadow: 0 20px 60px rgba(0,0,0,0.35); }
  .shot__bar { display: flex; gap: 7px; padding: 12px 14px; background: rgba(255,255,255,0.04); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .shot__bar span { width: 11px; height: 11px; border-radius: 50%; background: rgba(255,255,255,0.18); }
  .shot__img { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) { .hero__inner { grid-template-columns: 1fr; gap: 36px; } }
</style>
